## =========================================================================
## .gitignore for Visual Studio / C# / .NET Project
## =========================================================================

# Build results and binaries
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio files & cache
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.launchSettings.json.user

# Rider / JetBrains IDE
.idea/
*.sln.iml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Crash dumps & memory leaks
*.dmp
*.dump
*.crashdump

# NuGet Packages & local package folders
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Microsoft SQL Server / LocalDB files (nếu có database local đính kèm)
*.mdf
*.ldf
*.ndf

# Local configs and sensitive files
*.local.json
appsettings.*.local.json

# Tool / Analysis cache & outputs
graphify-out/
.gemini/

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
